# MCP transport
NETEASE_MCP_TRANSPORT=stdio
NETEASE_MCP_HOST=127.0.0.1
NETEASE_MCP_PORT=8766
NETEASE_MCP_PATH=/mcp

# Backend and optional authentication (never commit real values)
NETEASE_BACKEND=netease-web
NETEASE_WRITE_OPERATIONS_ENABLED=true
NETEASE_COOKIE=
NETEASE_MUSIC_U=
NETEASE_CSRF=
NETEASE_USER_ID=

# Shared HTTP client
NETEASE_CONNECT_TIMEOUT_SECONDS=5
NETEASE_REQUEST_TIMEOUT_SECONDS=15
NETEASE_MAX_CONNECTIONS=20
NETEASE_MAX_KEEPALIVE_CONNECTIONS=10
NETEASE_RETRY_ATTEMPTS=2
NETEASE_RETRY_INITIAL_SECONDS=0.25

# Request bounds
NETEASE_DEFAULT_PAGE_SIZE=20
NETEASE_MAX_PAGE_SIZE=100
NETEASE_MAX_BATCH_SONG_IDS=100
NETEASE_DEFAULT_TOP_SONG_COUNT=10
NETEASE_MAX_TOP_SONG_COUNT=50
NETEASE_DEFAULT_LYRICS_LIMIT=50
NETEASE_MAX_LYRICS_LIMIT=200
NETEASE_MAX_STATISTICS_TRACKS=1000

# Normalized data cache: none, memory, or sqlite
NETEASE_CACHE_BACKEND=memory
NETEASE_CACHE_PATH=.cache/netease-music-mcp/cache.sqlite3
NETEASE_SEARCH_CACHE_TTL_SECONDS=300
NETEASE_DETAIL_CACHE_TTL_SECONDS=1800
NETEASE_LYRICS_CACHE_TTL_SECONDS=3600
NETEASE_LIBRARY_CACHE_TTL_SECONDS=60

NETEASE_LOG_LEVEL=INFO

# Live read-only test opt-in
NETEASE_INTEGRATION_ENABLED=false
